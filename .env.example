# EasyLearn — copy to .env and fill in values. Never commit .env.

# Public URLs (must match Canvas Developer Keys and your ingress / tunnel)
CANVAS_API_URL=https://canvas.example.com
CANVAS_PUBLIC_URL=https://canvas.example.com
EASYLEARN_PUBLIC_URL=https://easylearn.example.com

# Admin API token — CLI utilities only (configure_lti.py, configure_oauth.py)
CANVAS_API_TOKEN=

# Per-professor OAuth — run: uv run utils/configure_oauth.py --write-env
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_OAUTH_REDIRECT_URI=https://easylearn.example.com/oauth/callback

# AI provider (at least one required for quiz generation)
# Default catalog model is OpenRouter Nemotron Ultra (:free) when OPENROUTER_API_KEY is set.
OPENROUTER_API_KEY=
# Optional OpenRouter attribution headers:
# OPENROUTER_HTTP_REFERER=https://easylearn.example.com
# OPENROUTER_APP_NAME=EasyLearn
GEMINI_API_KEY=

# Session encryption — generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# --- Docker Compose (optional) ---
# Cloudflare tunnel: docker compose --profile tunnel up -d --build
# TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel
# Slim image by default. To bake OCR/RAG packages into the image:
# UV_EXTRAS=--extra ocr
# UV_EXTRAS=--extra ocr --extra rag
# OCR_ENABLED=true
# RAG_ENABLED=true

# --- Local Canvas in Docker (common dev setup) ---
# If Canvas runs in Docker and is reached at a different internal hostname
# (e.g. canvas.docker from inside containers), set this so EasyLearn sends the
# correct Host header for API calls and file downloads during local testing.
# CANVAS_INTERNAL_HOST=canvas.docker
