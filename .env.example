# Canvas LMS (local Docker) — copy to .env in the repository root (not utils/ subdirectory) and fill CANVAS_API_TOKEN and GEMINI_API_KEY

CANVAS_API_URL=http://localhost:3000
CANVAS_API_TOKEN=

# Canvas OAuth2 (leave empty or commented for direct dev with admin CANVAS_API_TOKEN)
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=
# CANVAS_OAUTH_REDIRECT_URI=http://canvas.docker:8000/oauth/callback

# Offline course export (relative to project root)
 # Where is the directory containing the course export?
COURSE_EXPORT_DIR=Spring-2026-COMPUTER-SCIENCE-PRINCIPLES-CS-10051-600--2026-May-27_17-59-33-518
# What account is creating this course?
CANVAS_ACCOUNT_ID=1
# What is the `course_id`?
# Local Docker test course (CS-10051-600); auto-picked on direct access if omitted
CANVAS_COURSE_ID=3

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (https://openrouter.ai/keys) — fallback models in config/ai_models.json
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=EasyLearn

# Starlette session encryption key (LTI FastAPI dashboard)
SESSION_SECRET_KEY=some-very-secret-key-change-in-production

# LTI browser URLs for Docker dev (/etc/hosts: 127.0.0.1 canvas.docker)
# CANVAS_PUBLIC_URL=http://canvas.docker:3000
# EASYLEARN_PUBLIC_URL=http://canvas.docker:8000

# Per-user Canvas API (separate Developer Key from LTI — not the LTI key)
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=
# CANVAS_OAUTH_REDIRECT_URI=http://canvas.docker:8000/oauth/callback

